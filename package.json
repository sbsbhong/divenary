{
  "name": "dive-app",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:quick": "yarn generate",
    "codex:check": "yarn check:quick && yarn mobile:typecheck && yarn watch:build",
    "generate": "turbo run generate",
    "generate:supabase": "yarn workspace @repo/supabase generate:types",
    "ios:build": "yarn workspace @repo/mobile ios:build",
    "lint": "turbo run lint",
    "mobile:typecheck": "yarn workspace @repo/mobile typecheck",
    "mobile:auth:local:prepare": "node supabase/scripts/prepare-local-mobile-auth.mjs",
    "mobile:start:local": "MOBILE_ENVIRONMENT=local yarn workspace @repo/mobile start",
    "mobile:ios:local": "MOBILE_ENVIRONMENT=local yarn workspace @repo/mobile ios",
    "mobile:android:local": "MOBILE_ENVIRONMENT=local yarn workspace @repo/mobile android",
    "supabase": "supabase",
    "supabase:advisors": "node supabase/scripts/run-local-supabase.mjs db advisors --local --type security --fail-on error",
    "supabase:lint:db": "node supabase/scripts/run-local-supabase.mjs db lint --local --fail-on error",
    "supabase:local": "node supabase/scripts/run-local-supabase.mjs",
    "supabase:reset": "node supabase/scripts/run-local-supabase.mjs db reset",
    "supabase:staging:link": "node supabase/scripts/run-staging-supabase.mjs link --project-ref mclvhwzsuvsxjerdouka",
    "supabase:staging:migrations": "node supabase/scripts/run-staging-supabase.mjs migration list --linked",
    "supabase:staging:push:dry-run": "node supabase/scripts/run-staging-supabase.mjs db push --linked --dry-run",
    "supabase:staging:push": "node supabase/scripts/run-staging-supabase.mjs db push --linked",
    "supabase:staging:seed:auth": "node supabase/scripts/staging-project.mjs seed",
    "supabase:staging:verify:auth": "node supabase/scripts/verify-staging-auth.mjs",
    "supabase:start": "node supabase/scripts/run-local-supabase.mjs start",
    "supabase:stop": "node supabase/scripts/run-local-supabase.mjs stop",
    "supabase:test:db": "node supabase/scripts/run-local-supabase.mjs test db",
    "test": "turbo run test",
    "watch:build": "yarn workspace @repo/mobile watch:build"
  },
  "devDependencies": {
    "supabase": "2.109.1",
    "turbo": "^2.0.12"
  }
}
