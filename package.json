{
  "name": "dive-app",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:quick": "yarn generate",
    "codex:check": "yarn check:quick && yarn mobile:typecheck && yarn watch:build",
    "generate": "turbo run generate",
    "ios:build": "yarn workspace @repo/mobile ios:build",
    "lint": "turbo run lint",
    "mobile:typecheck": "yarn workspace @repo/mobile typecheck",
    "supabase": "supabase",
    "supabase:advisors": "node supabase/scripts/run-local-supabase.mjs db advisors --local --type security --fail-on error",
    "supabase:lint:db": "node supabase/scripts/run-local-supabase.mjs db lint --local --fail-on error",
    "supabase:local": "node supabase/scripts/run-local-supabase.mjs",
    "supabase:reset": "node supabase/scripts/run-local-supabase.mjs db reset",
    "supabase:start": "node supabase/scripts/run-local-supabase.mjs start",
    "supabase:stop": "node supabase/scripts/run-local-supabase.mjs stop",
    "supabase:test:db": "node supabase/scripts/run-local-supabase.mjs test db",
    "test": "turbo run test",
    "watch:build": "yarn workspace @repo/mobile watch:build"
  },
  "devDependencies": {
    "supabase": "2.109.1",
    "turbo": "^2.0.12"
  }
}
