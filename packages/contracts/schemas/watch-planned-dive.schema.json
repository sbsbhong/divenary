{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.dive-app.local/watch-planned-dive.schema.json",
  "title": "WatchPlannedDive",
  "description": "A planned dive the watch can start. It carries no account or backend identifiers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "localId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "siteName": {
      "type": "string"
    },
    "diveMode": {
      "enum": [
        "scuba",
        "freedive"
      ]
    },
    "entryStyle": {
      "type": "string"
    },
    "plannedAt": {
      "description": "Seconds since 1970-01-01T00:00:00Z.",
      "type": "number",
      "minimum": 0
    },
    "plannedMaxDepthMeters": {
      "type": "number",
      "minimum": 0
    },
    "plannedDurationMinutes": {
      "type": "number",
      "minimum": 0
    },
    "gasLabel": {
      "type": "string"
    },
    "buddyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gearIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "localId",
    "buddyIds",
    "gearIds",
    "tags"
  ]
}
