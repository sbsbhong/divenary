{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.dive-app.local/watch-link-messages.schema.json",
  "title": "WatchLinkMessage",
  "description": "Control messages between the phone and its companion watch. Every message is a flat object of string keys and JSON values, so any phone-watch transport can carry it.",
  "oneOf": [
    {
      "$ref": "#/definitions/WatchSyncFileMetadata"
    },
    {
      "$ref": "#/definitions/WatchSyncAcknowledgement"
    },
    {
      "$ref": "#/definitions/WatchPlannedDivesContext"
    },
    {
      "$ref": "#/definitions/WatchSessionDeletionCommand"
    },
    {
      "$ref": "#/definitions/WatchSessionDeletionAcknowledgement"
    }
  ],
  "definitions": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Timestamp": {
      "description": "Seconds since 1970-01-01T00:00:00Z.",
      "type": "number",
      "minimum": 0
    },
    "WatchSyncFileMetadata": {
      "title": "WatchSyncFileMetadata",
      "description": "Watch to phone. Metadata sent with the session file; the file holds one WatchSyncMessage and its bytes are delivered unchanged.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "watchSyncMessage"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "localSessionId": {
          "type": "string",
          "minLength": 1
        },
        "contentRevision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/Sha256Hex"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "sentAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "kind",
        "formatVersion",
        "localSessionId",
        "contentRevision",
        "sha256",
        "byteCount",
        "sampleCount",
        "sentAt"
      ]
    },
    "WatchSyncAcknowledgement": {
      "title": "WatchSyncAcknowledgement",
      "description": "Phone to watch. The session file with this identity is stored in the phone's local logbook; it says nothing about cloud upload.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "watchSyncAcknowledgement"
        },
        "localSessionId": {
          "type": "string",
          "minLength": 1
        },
        "contentRevision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/definitions/Sha256Hex"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "acknowledgedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "kind",
        "localSessionId",
        "contentRevision",
        "sha256",
        "acknowledgedAt"
      ]
    },
    "WatchPlannedDivesContext": {
      "title": "WatchPlannedDivesContext",
      "description": "Phone to watch, latest value only. plannedDivesJson is a JSON array of WatchPlannedDive (watch-planned-dive.schema.json).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "watchPlannedDives"
        },
        "plannedDivesJson": {
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "kind",
        "plannedDivesJson"
      ]
    },
    "WatchSessionDeletionCommand": {
      "title": "WatchSessionDeletionCommand",
      "description": "Phone to watch, queued. Delete one saved session; the revision and artifact digest are sent together or not at all.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "watchSessionDeletionCommand"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "commandId": {
          "$ref": "#/definitions/Sha256Hex"
        },
        "localSessionId": {
          "type": "string",
          "minLength": 1
        },
        "requestedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "contentRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "artifactSha256": {
          "$ref": "#/definitions/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "formatVersion",
        "commandId",
        "localSessionId",
        "requestedAt"
      ],
      "dependencies": {
        "contentRevision": [
          "artifactSha256"
        ],
        "artifactSha256": [
          "contentRevision"
        ]
      }
    },
    "WatchSessionDeletionAcknowledgement": {
      "title": "WatchSessionDeletionAcknowledgement",
      "description": "Watch to phone, queued. The session is gone from the watch, or was never there.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "watchSessionDeletionAcknowledgement"
        },
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "commandId": {
          "$ref": "#/definitions/Sha256Hex"
        },
        "localSessionId": {
          "type": "string",
          "minLength": 1
        },
        "acknowledgedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "result": {
          "enum": [
            "deleted",
            "alreadyAbsent"
          ]
        },
        "removedContentRevision": {
          "type": "string",
          "minLength": 1
        },
        "removedArtifactSha256": {
          "$ref": "#/definitions/Sha256Hex"
        }
      },
      "required": [
        "kind",
        "formatVersion",
        "commandId",
        "localSessionId",
        "acknowledgedAt",
        "result"
      ],
      "dependencies": {
        "removedContentRevision": [
          "removedArtifactSha256"
        ],
        "removedArtifactSha256": [
          "removedContentRevision"
        ]
      }
    }
  }
}
