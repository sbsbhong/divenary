{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.dive-app.local/watch-session.schema.json",
  "title": "WatchSession",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "watchLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "horizontalAccuracyMeters": {
          "type": "number"
        },
        "capturedAt": {
          "type": "number",
          "description": "Unix timestamp in seconds"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "freeDiveSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "startedAt": {
          "type": "number",
          "description": "Unix timestamp in seconds"
        },
        "endedAt": {
          "type": "number",
          "description": "Unix timestamp in seconds"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "maxDepthMeters": {
          "type": "number",
          "minimum": 0
        },
        "minDepthMeters": {
          "type": "number",
          "minimum": 0
        },
        "sampleStartIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sampleEndIndex": {
          "type": "integer",
          "minimum": 0
        },
        "descentRateMetersPerSecond": {
          "type": "number"
        },
        "ascentRateMetersPerSecond": {
          "type": "number"
        }
      },
      "required": [
        "segmentId",
        "index",
        "startedAt",
        "endedAt",
        "durationSeconds",
        "maxDepthMeters",
        "minDepthMeters",
        "sampleStartIndex",
        "sampleEndIndex"
      ]
    },
    "freeDivePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diveCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepthMeters": {
          "type": "number",
          "minimum": 0
        },
        "longestDiveDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/freeDiveSegment"
          }
        }
      },
      "required": [
        "diveCount",
        "maxDepthMeters",
        "longestDiveDurationSeconds",
        "segments"
      ]
    },
    "safetyStopRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "notRequired",
            "armed",
            "active",
            "pausedTooDeep",
            "pausedTooShallow",
            "completed",
            "skippedOrIncomplete"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "targetDepthMeters": {
          "type": "number"
        },
        "minDepthMeters": {
          "type": "number"
        },
        "maxDepthMeters": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "startedAt": {
          "type": "number",
          "description": "Unix timestamp in seconds"
        },
        "completedAt": {
          "type": "number",
          "description": "Unix timestamp in seconds"
        },
        "remainingSeconds": {
          "type": "number",
          "minimum": 0
        },
        "timeInZoneSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "required",
        "completed",
        "targetDepthMeters",
        "minDepthMeters",
        "maxDepthMeters",
        "durationSeconds",
        "remainingSeconds",
        "timeInZoneSeconds"
      ]
    },
    "scubaPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gasLabel": {
          "type": "string"
        },
        "maxDepthMeters": {
          "type": "number",
          "minimum": 0
        },
        "averageDepthMeters": {
          "type": "number",
          "minimum": 0
        },
        "waterTemperatureCelsius": {
          "type": "number"
        },
        "latestAscentRateMetersPerMinute": {
          "type": "number",
          "minimum": 0
        },
        "maxAscentRateMetersPerMinute": {
          "type": "number",
          "minimum": 0
        },
        "safetyStop": {
          "$ref": "#/definitions/safetyStopRecord"
        }
      },
      "required": [
        "maxDepthMeters",
        "averageDepthMeters",
        "latestAscentRateMetersPerMinute",
        "maxAscentRateMetersPerMinute",
        "safetyStop"
      ]
    }
  },
  "properties": {
    "localSessionId": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "diveMode": {
      "type": "string",
      "enum": [
        "scuba",
        "freedive"
      ]
    },
    "gasLabel": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "siteName": {
      "type": "string"
    },
    "sourcePlanLocalId": {
      "type": "string"
    },
    "planTitle": {
      "type": "string"
    },
    "buddyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gearIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "perceivedExertion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "visibilityRating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "waterCondition": {
      "type": "string",
      "enum": [
        "calm",
        "mild",
        "choppy",
        "surge",
        "current",
        "unknown"
      ]
    },
    "syncStatus": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "failed"
      ]
    },
    "entryLocation": {
      "$ref": "#/definitions/watchLocation"
    },
    "exitLocation": {
      "$ref": "#/definitions/watchLocation"
    },
    "startedAt": {
      "type": "number",
      "description": "Unix timestamp in seconds"
    },
    "endedAt": {
      "type": "number",
      "description": "Unix timestamp in seconds"
    },
    "maxDepthMeters": {
      "type": "number"
    },
    "averageDepthMeters": {
      "type": "number"
    },
    "waterTemperatureCelsius": {
      "type": "number"
    },
    "freedive": {
      "$ref": "#/definitions/freeDivePayload"
    },
    "scuba": {
      "$ref": "#/definitions/scubaPayload"
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "./watch-depth-sample.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diveMode": {
            "const": "freedive"
          }
        },
        "required": [
          "diveMode"
        ]
      },
      "then": {
        "required": [
          "freedive"
        ],
        "not": {
          "required": [
            "scuba"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "diveMode": {
            "const": "scuba"
          }
        },
        "required": [
          "diveMode"
        ]
      },
      "then": {
        "required": [
          "scuba"
        ],
        "not": {
          "required": [
            "freedive"
          ]
        }
      }
    }
  ],
  "required": [
    "localSessionId",
    "startedAt",
    "samples"
  ]
}
