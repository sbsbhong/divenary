{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.dive-app.local/watch-profile-metadata.schema.json",
  "title": "WatchProfileMetadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "contentRevision": {
      "type": "string",
      "minLength": 1
    },
    "sampleIntervalSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 1
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "interrupted": {
      "type": "boolean"
    }
  },
  "required": [
    "formatVersion",
    "contentRevision",
    "sampleIntervalSeconds",
    "sampleCount"
  ]
}
